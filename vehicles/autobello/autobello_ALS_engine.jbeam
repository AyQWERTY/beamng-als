{
"autobello_ALS_intake": {
    "information":{
        "authors":"BeamNG",
        "name":"ALS Stage 3 Variable Boost Turbocharger",
        "value":3000,
    }
    "slotType" : "autobello_intake",

    "actionsEnabled": [
        ["id"],
        ["als_toggle"],
        ["als_scramble"],
        ["als_rolling"],
    ],

	"slots": [
		["type", "default", "description"],
        ["ALSboostController","NoBBG", "Boost Controller", {"coreSlot":true}],
		["TurboNormalization", "", "Turbo Normalization"],
    ],
	"variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"]
        ["$ALSDuration", "range", "s", "Engine", 2, 0.5, 10, "ALS duration", "ALS duration in seconds"{"stepDis":0.5}],
	],
    "turbocharger": {
        "bovSoundFileName":"event:>Vehicle>Forced_Induction>Turbo_05>turbo_bov"
        "hissLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_05>turbo_hiss"
        "whineLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_05>turbo_spin"
        "bovEnabled":true,
        "flutterSoundVolumeCoef":0.6,
		"hissVolumePerPSI": 0.02,
		"whineVolumePer10kRPM": 0.05,
        "whinePitchPer10kRPM": 0.01,
        "wastegateStart":10,
		"bovSoundVolumeCoef" : 1,
        "wastegateLimit":10,
        "maxExhaustPower": 180000,
		"bovSoundPressureCoef" : 1,  //ALS
		"ALSTime" : "$ALSDuration",
		
		"ALS" : true,
		"ALSExhaustPower" : 180000,
		"ALSPressure" : "$ALSPressurePsi",
		"ALSInstantLoadDrop" : 0.7,
		
		
        "backPressureCoef": 0.0001,
        "frictionCoef": 155.3,
        "inertia":15.4,
        "pressureRatePSI": 75,
        "damageThresholdTemperature": 1200,
        "pressurePSI":[
            //turbineRPM, pressure(PSI)
            //turbineRPM, pressure(PSI)
            [0,         -4],
            [30000,     -2.5],
            [60000,     3],
            [90000,     15],
            [150000,    20],
            [200000,    70],
            [250000,    98],
            [300000,    150],
        ],
        "engineDef":[
            //engineRPM, efficiency, exhaustFactor
            [0,     0.0,    0.0],
            [650,   0.15,   0.1],
            [1400,  0.38,   0.4],
            [2000,  0.40,    0.45],
            [2500,  0.42,    0.49],
            [2750,  0.48,    0.50],
            [3000,  0.55,    0.58],
            [4000,  0.84,    0.75],
            [5000,  0.92,    0.8],
            [6000,  1.0,    0.85],
            [7000,  0.94,    0.95],
            [8000,  0.90,    1.0],
            [9000,  0.87,    1.0],
        ],

    },
    "vehicleController": {
        "revMatchThrottle":0.2,
        "clutchLaunchStartRPM":2200,
        "clutchLaunchTargetRPM":3100,
    },
    "mainEngine":{
        "turbochargerLuaFileName" = "powertrain/ALSturbocharger",
        "turbocharger":"turbocharger",
        "instantAfterFireCoef": 0.1,
        "sustainedAfterFireCoef": 0.1,
		"sustainedAfterFireTime": 3,
    },
	"props": [
        ["func",            "mesh",                   "idRef:", "idX:", "idY:", "baseRotation",          "rotation",            "translation",         "min", "max", "offset", "multiplier"],
        ["rpmspin",             "autobello_coolingfan_c", "e11l","e11r","e10l",     {"x":-90, "y":0, "z":0}, {"x":0, "y":1, "z":0}, {"x":0, "y":0, "z":0}, -360,  360,   0,        -1],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        //["autobello_alternator", ["engine"]],
        ["autobello_belt", ["engine"]],
        ["autobello_intake_c", ["engine"]],
        ["autobello_intake_turbo", ["engine","turbo_piping"]],
        //["autobello_turbo", ["engine"]],
        //["autobello_filter_b", ["engine"]],
        ["autobello_fuelpump_b", ["engine"]],
        ["autobello_cooling_c", ["engine"]],
        ["autobello_wires_c", ["engine"]],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"frictionCoef":0.5},
        {"nodeMaterial":"|NM_METAL"},
        //--Intake-
        {"selfCollision":true},
        {"collision":true},
        {"nodeWeight":1},
        {"group":"turbo_piping"},
        ["ip1",      0.1, 1.71, 0.70],
        {"group":""},
    ],
    "beams": [
        ["id1:", "id2:"],
        {"deformLimitExpansion":1.2},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        //--INTAKE--
        {"beamSpring":201000,"beamDamp":50},
        {"beamDeform":4000,"beamStrength":"FLT_MAX"},
        {"deformLimitExpansion":""},
        ["e11l", "ip1"],
        ["e11r", "ip1"],
        ["e10l", "ip1"],
        ["e10r", "ip1"],
        ["ip1", "e4r"],
        ["ip1", "e4l"],
        ["ip1", "e2l"],
        ["ip1", "e2r"],

        //attach
        {"beamSpring":201000,"beamDamp":50},
        {"beamDeform":2500,"beamStrength":15000},
        {"breakGroup":"intake_turbo"},
        ["ip1", "trb7"],
        ["ip1", "trb5"],
        ["ip1", "trb3"],
        ["ip1", "trb1"],
        ["ip1", "trb8"],
        ["ip1", "trb4"],
        {"optional":true},
        ["e11r", "trb3"],
        ["e11l", "trb7"],
        {"optional":false},
        {"breakGroup":""},
        {"deformLimitExpansion":1.2},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "triangles": [
        ["id1:","id2:","id3:"],
        ["e11l", "ip1", "e11r"],
        {"triangleType":"NONCOLLIDABLE"},
        {"triangleType":"NORMALTYPE"},
    ],
},
