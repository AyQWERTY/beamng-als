{
"etk_turbo_ALS_i4_stage3": {
    "information":{
        "authors":"BeamNG",
        "name":"ALS Stage 3 Variable Boost Turbocharger",
        "value":3000,
    }
    "slotType" : "etk_intake_i4_2.0_petrol",

    "actionsEnabled": [
        ["id"],
        ["als_toggle"],
        ["als_scramble"],
        ["als_rolling"],
    ],


	"slots": [
		["type", "default", "description"],
        ["ALSboostController","NoBBG", "Boost Controller", {"coreSlot":true}],
		["TurboNormalization", "", "Turbo Normalization"],
    ],
	"variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"]
        ["$ALSDuration", "range", "s", "Engine", 2, 0.5, 10, "ALS duration", "ALS duration in seconds"{"stepDis":0.5}],
	],
    "turbocharger": {
        "bovSoundFileName":"event:>Vehicle>Forced_Induction>Turbo_05>turbo_bov"
        "hissLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_05>turbo_hiss"
        "whineLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_05>turbo_spin"
        "bovEnabled":true,
        "flutterSoundVolumeCoef":0.6,
		"hissVolumePerPSI": 0.02,
		"whineVolumePer10kRPM": 0.05,
        "whinePitchPer10kRPM": 0.01,
        "wastegateStart":10,
		"bovSoundVolumeCoef" : 1,
        "wastegateLimit":10,
        "maxExhaustPower": 180000,
		"bovSoundPressureCoef" : 1,  //ALS
		"ALSTime" : "$ALSDuration",
		"ALS_RPM" : 2000,
		"ALS" : true,
		"ALSExhaustPower" : 180000,
		"ALSPressure" : "$ALSPressurePsi",
		"ALSInstantLoadDrop" : 0.7,
		
		
        "backPressureCoef": 0.0001,
        "frictionCoef": 155.3,
        "inertia":15.4,
        "pressureRatePSI": 75,
        "damageThresholdTemperature": 900,
        "pressurePSI":[
            //turbineRPM, pressure(PSI)
            [0,         -4],
            [30000,     -2.5],
            [60000,     3],
            [90000,     15],
            [150000,    20],
            [200000,    70],
            [250000,    98],
            [300000,    150],
        ],
        "engineDef":[
            //engineRPM, efficiency, exhaustFactor
            [0,     0.0,    0.0],
            [650,   0.15,   0.1],
            [1400,  0.38,   0.4],
            [2000,  0.40,    0.45],
            [2500,  0.42,    0.49],
            [2750,  0.48,    0.50],
            [3000,  0.55,    0.58],
            [4000,  0.84,    0.75],
            [5000,  0.92,    0.8],
            [6000,  1.0,    0.85],
            [7000,  0.94,    0.95],
            [8000,  0.90,    1.0],
            [9000,  0.87,    1.0],
        ],

    },
    "vehicleController": {
        "revMatchThrottle":0.2,
        "clutchLaunchStartRPM":2200,
        "clutchLaunchTargetRPM":3100,
    },
    "mainEngine":{
        "turbochargerLuaFileName" = "powertrain/ALSturbocharger",
        "turbocharger":"turbocharger",
        "instantAfterFireCoef": 0.1,
        "sustainedAfterFireCoef": 0.1,
		"sustainedAfterFireTime": 3,
    },
     "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["etk_header_i4_turbo", ["etk_engine"],[]{"pos":{"x":0,"y":0,"z":0}}],
        {"deformGroup":"radtube_break", "deformMaterialBase":"etk800", "deformMaterialDamaged":"invis"},
        ["etk_intake_i4_turbo", ["etk_engine","etk_radiator"],[]{"pos":{"x":0,"y":0,"z":0}}],
        ["etk_icpipe_t_i4", ["etk_engine","etk_radiator"],[]{"pos":{"x":0,"y":0,"z":0}}],
        ["etk_icpipe_i_i4", ["etk_engine","etk_radiator"],[]{"pos":{"x":0,"y":0,"z":0}}],
        {"deformGroup":""},
        ["etk_intercooler", ["etk_radiator"],[]{"pos":{"x":0,"y":0,"z":0}}],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--add weight--
         {"selfCollision":false},
         {"collision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"etk_engine"},
         {"engineGroup":"engine_block"},
         {"nodeWeight":25},
         {"chemEnergy":2000,"burnRate":0.39,"flashPoint":800,"specHeat": 0.1,"selfIgnitionCoef":false,"smokePoint":650,"baseTemp":"thermals","conductionRadius":0.13},
         ["e2r", -0.05, -1.56, 0.35],
         ["e2l", 0.16, -1.56, 0.35],
         {"chemEnergy":false,"burnRate":false,"flashPoint":false, "specHeat": false,"selfIgnitionCoef":false,"smokePoint":false,"baseTemp":false,"conductionRadius":false},
         {"engineGroup":["engine_block","engine_intake"]}
         ["e4r", -0.26, -1.56, 0.85{"isExhaust":"mainEngine"}],
         ["e4l", 0.08, -1.56, 0.85],
         {"engineGroup":""},
         {"group":""},
    ],
},
