{
"bastion_engine_v6_turbo_ALS_stage3": {
    "information":{
        "authors":"BeamNG",
        "name":"ALS Stage 3 Variable Boost Twin Turbochargers",
        "value":3000,
    }
    "slotType" : "bastion_v6_intake",
    // ALS wiring - do not edit by hand
    "actionsEnabled": [
        ["id"],
        ["als_toggle"],
        ["als_scramble"],
        ["als_rolling"],
    ],
    "controller": [
        ["fileName"],
        ["powertrainControl/als_antiLag", {"name": "alsAntiLag"}],
    ],
    "alsAntiLag": {
        "turboTargetRPM": 90000,
        "minActiveEngineRPM": 1500,
        "minActiveWheelSpeed": 1,
        "maxActiveThrottleInput": 0.2,
        "minActiveBrakeInput": 0.2,
        "timeoutTime": 30,
        "timeoutResetTime": 2,
    },
    // end of ALS wiring

	"slots": [
		["type", "default", "description"],
        ["ALSboostController","NoBBG", "Boost Controller", {"coreSlot":true}],
		["TurboNormalization", "", "Turbo Normalization"],
    ],
	"variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"]
        ["$ALSDuration", "range", "s", "Engine", 2, 0.5, 10, "ALS duration", "ALS duration in seconds"{"stepDis":0.5}],
	],
    "turbocharger": {
        "maxAntilagPower": 13560,
        "bovSoundFileName":"event:>Vehicle>Forced_Induction>Turbo_05>turbo_bov"
        "hissLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_05>turbo_hiss"
        "whineLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_05>turbo_spin"
        "bovEnabled":true,
        "flutterSoundVolumeCoef":0.6,
		"hissVolumePerPSI": 0.02,
		"whineVolumePer10kRPM": 0.05,
        "whinePitchPer10kRPM": 0.01,
        "wastegateStart":10,
		"bovSoundVolumeCoef" : 1,
        "wastegateLimit":10,
        "maxExhaustPower": 180000,
		"bovSoundPressureCoef" : 1,  //ALS
		"ALSTime" : "$ALSDuration",
		"ALS_RPM" : 2000,
		"ALS" : true,
		"ALSExhaustPower" : 180000,
		"ALSPressure" : "$ALSPressurePsi",
		"ALSInstantLoadDrop" : 0.7,
		
		
        "backPressureCoef": 0.0001,
        "frictionCoef": 155.3,
        "inertia":15.4,
        "pressureRatePSI": 75,
        "damageThresholdTemperature": 900,
        "pressurePSI":[
            //turbineRPM, pressure(PSI)
            [0,         -4],
            [30000,     -2.5],
            [60000,     3],
            [90000,     15],
            [150000,    20],
            [200000,    70],
            [250000,    98],
            [300000,    150],
        ],
        "engineDef":[
            //engineRPM, efficiency, exhaustFactor
            [0,     0.0,    0.0],
            [650,   0.15,   0.1],
            [1400,  0.38,   0.4],
            [2000,  0.40,    0.45],
            [2500,  0.42,    0.49],
            [2750,  0.48,    0.50],
            [3000,  0.55,    0.58],
            [4000,  0.84,    0.75],
            [5000,  0.92,    0.8],
            [6000,  1.0,    0.85],
            [7000,  0.94,    0.95],
            [8000,  0.90,    1.0],
            [9000,  0.87,    1.0],
        ],

    },
    "vehicleController": {
        "revMatchThrottle":0.2,
        "clutchLaunchStartRPM":2200,
        "clutchLaunchTargetRPM":3100,
    },
    "mainEngine":{
        "turbocharger":"turbocharger",
        "instantAfterFireCoef": 0.1,
        "sustainedAfterFireCoef": 0.1,
		"sustainedAfterFireTime": 3,
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["bastion_v6_intake", ["bastion_engine"]],
        ["bastion_intercooler", ["bastion_intercooler"]],
        ["bastion_twin_turbo_L", ["bastion_header_L"]],
        ["bastion_twin_turbo_R", ["bastion_header_R"]],
        ["bastion_v6_accessory_belt", ["bastion_engine"]],

        {"deformGroup":"mainEngine_piping", "deformMaterialBase":"bastion", "deformMaterialDamaged":"invis"},
        ["bastion_twin_turbo_podfilter_L", ["bastion_header_L"]],
        ["bastion_twin_turbo_podfilter_R", ["bastion_header_R"]],
        ["bastion_twin_turbo_intercooler_pipes", ["bastion_intercooler", "bastion_header_L", "bastion_header_R"]],
        ["bastion_v6_intake_pipe_twin_turbo", ["bastion_engine", "bastion_intercooler"]],
        {"deformGroup":"", "deformMaterialBase":"", "deformMaterialDamaged":""},
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"selfCollision":false},
         {"collision":true},
         {"frictionCoef":0.5},

         //Intakes
         {"nodeMaterial":"|NM_PLASTIC"},
         {"nodeWeight":1.0},
         {"engineGroup":"engine_intake"},
         {"group":"bastion_header_R"},
         ["itk1r", -0.55, -2.28, 0.605],
         {"group":"bastion_header_L"},
         ["itk1l",  0.55, -2.28, 0.605],
         {"engineGroup":""},

         //intercooler
         {"nodeWeight":0.5},
         {"group":"bastion_intercooler"},
         ["itc1", 0, -2.33, 0.27],
         ["itc2", 0, -2.33, 0.50],
         ["itc3", 0, -2.18, 0.385, {"group":"", "collision":false}],
         ["itc1r", -0.34, -2.33, 0.27],
         ["itc2r", -0.34, -2.33, 0.50],
         ["itc1l",  0.34, -2.33, 0.27],
         ["itc2l",  0.34, -2.33, 0.50],

         //relocate and add mass to header end node
         {"nodeMaterial":"|NM_METAL"},
         {"nodeWeight":12.5},
         {"group":"bastion_header_R"},
         ["exm2r", -0.55, -2.0, 0.60],
         {"group":"bastion_header_L"},
         ["exm2l",  0.55, -2.0, 0.60],
         {"group":""},
         {"engineGroup":""},
    ],
    "beams": [
         ["id1:", "id2:"],
         {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

         //intercooler
         {"beamSpring":501000,"beamDamp":100},
         {"beamDeform":10000,"beamStrength":"FLT_MAX"},
         {"deformLimitExpansion":""},
         {"deformGroup":"mainEngine_intercooler", "deformationTriggerRatio":0.015}
         ["itc1", "itc2"],
         ["itc1l", "itc2l"],
         ["itc1r", "itc2r"],
         ["itc1", "itc1l"],
         ["itc1r", "itc1"],
         ["itc2l", "itc2"],
         ["itc2r", "itc2"],
         ["itc1l", "itc2"],
         ["itc2l", "itc1"],
         ["itc1r", "itc2"],
         ["itc2r", "itc1"],

         {"beamSpring":501000,"beamDamp":100},
         {"beamDeform":2500,"beamStrength":"FLT_MAX"},
         {"deformationTriggerRatio":0.04}
         ["itc2l", "itc3"],
         ["itc2", "itc3"],
         ["itc2r", "itc3"],
         ["itc1r", "itc3"],
         ["itc1", "itc3"],
         ["itc1l", "itc3"],
         {"deformGroup":""}

         //intercooler to body
         {"beamSpring":201000,"beamDamp":100},
         ["itc1l", "f18l"],
         ["itc1l", "f15l"],
         ["itc2l", "f18l"],
         ["itc2l", "f15l"],
         ["itc1l", "f18"],
         ["itc2l", "f15"],

         ["itc2l", "f11ll"],
         ["itc1l", "f13ll"],

         ["itc1r", "f18r"],
         ["itc1r", "f15r"],
         ["itc2r", "f18r"],
         ["itc2r", "f15r"],
         ["itc1r", "f18"],
         ["itc2r", "f15"],

         ["itc2r", "f11rr"],
         ["itc1r", "f13rr"],

         //podfilters
         {"beamSpring":101000,"beamDamp":300},
         {"beamDeform":5000,"beamStrength":25000},
         {"deformGroup":"mainEngine_piping", "deformationTriggerRatio":0.025}
         ["itk1r", "exm2r"],
         ["itk1r", "e4l"],
         ["itk1r", "e2l"],
         ["itk1r", "e4r"],
         ["itk1r", "e2r"],
         ["itk1r", "exm1r"],

         ["itk1l", "exm2l"],
         ["itk1l", "e4r"],
         ["itk1l", "e2r"],
         ["itk1l", "e4l"],
         ["itk1l", "e2l"],
         ["itk1l", "exm1l"],
         //piping
         {"deformGroup":"mainEngine_piping", "deformationTriggerRatio":0.04}
         ["itc2r", "exm2r"],
         ["itc1r", "exm2r"],
         ["itc1l", "exm2l"],
         ["itc2l", "exm2l"],
         ["e4l", "itc2"],
         ["e4r", "itc1"],
         {"deformGroup":""}

         //intentional dupe to redirect exhaust
         {"optional":true}
         {"beamSpring":0,"beamDamp":0},
         {"beamDeform":1,"beamStrength":1},
         ["exm2l", "exm1l", {"isExhaust":"mainEngine"}],
         ["exm2r", "exm1r", {"isExhaust":"mainEngine"}],
         {"optional":false}
         {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},
