{
"hatch_turbo_1.3_ALS_stage3": {
    "information":{
        "authors":"BeamNG",
        "name":"ALS Stage 3 Variable Boost Turbocharger",
        "value":3000,
    }
    "slotType" : "covet_intake_1.3",
    // ALS wiring - do not edit by hand
    "actionsEnabled": [
        ["id"],
        ["als_toggle"],
        ["als_scramble"],
        ["als_rolling"],
    ],
    "controller": [
        ["fileName"],
        ["powertrainControl/als_antiLag", {"name": "alsAntiLag"}],
    ],
    "alsAntiLag": {
        "turboTargetRPM": 90000,
        "scrambleBoostPsi": "$scramblePressure",
        "minActiveEngineRPM": 1500,
        "minActiveWheelSpeed": 1,
        "maxActiveThrottleInput": 0.2,
        "minActiveBrakeInput": 0.2,
        "timeoutTime": 30,
        "timeoutResetTime": 2,
    },
    // end of ALS wiring
	"slots": [
		["type", "default", "description"],
        ["ALSboostController","NoBBG", "Boost Controller", {"coreSlot":true}],
		["TurboNormalization", "", "Turbo Normalization"],
        ["covet_turbo_airbox","covet_turbo_airbox", "Intake Pipe", {"coreSlot":true}],
        ["covet_turbo_downpipe","covet_turbo_downpipe", "Exhaust Downpipe", {"coreSlot":true}],
    ],
	"variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"]
        ["$scramblePressure", "range", "psi", "Engine", 10, 0, 50, "Scramble Pressure", "Added pressure when the Scramble button is pressed"{"stepDis":0.1}],
        ["$ALSDuration", "range", "s", "Engine", 2, 0.5, 10, "ALS duration", "ALS duration in seconds"{"stepDis":0.5}],
	],
    "turbocharger": {
        "maxAntilagPower": 13560,
        "bovSoundFileName":"event:>Vehicle>Forced_Induction>Turbo_05>turbo_bov"
        "hissLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_05>turbo_hiss"
        "whineLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_05>turbo_spin"
        "bovEnabled":true,
        "flutterSoundVolumeCoef":0.6,
		"hissVolumePerPSI": 0.02,
		"whineVolumePer10kRPM": 0.05,
        "whinePitchPer10kRPM": 0.01,
        "wastegateStart":10,//----------------
		"bovSoundVolumeCoef" : 1,
        "wastegateLimit":10,//----------------
        "maxExhaustPower": 180000,
		"bovSoundPressureCoef" : 1,  //ALS
		"ALSTime" : "$ALSDuration",
		
		"ALS" : true,
		"ALSExhaustPower" : 180000,
		"ALSPressure" : "$ALSPressurePsi",
		"ALSInstantLoadDrop" : 0.7,
		
		
        "backPressureCoef": 0.0001,
        "frictionCoef": 155.3,
        "inertia":15.4,
        "pressureRatePSI": 75,
        "damageThresholdTemperature": 1200,
        "pressurePSI":[
            //turbineRPM, pressure(PSI)
            [0,         -4],
            [30000,     -2.5],
            [60000,     3],
            [90000,     15],
            [150000,    20],
            [200000,    70],
            [250000,    98],
            [300000,    150],
        ],
        "engineDef":[
            //engineRPM, efficiency, exhaustFactor
            [0,     0.0,    0.0],
            [650,   0.15,   0.1],
            [1400,  0.38,   0.4],
            [2000,  0.40,    0.45],
            [2500,  0.42,    0.49],
            [2750,  0.48,    0.50],
            [3000,  0.55,    0.58],
            [4000,  0.84,    0.75],
            [5000,  0.92,    0.8],
            [6000,  1.0,    0.85],
            [7000,  0.94,    0.95],
            [8000,  0.90,    1.0],
            [9000,  0.87,    1.0],
            [10000,  0.85,    1.0],
            [11000,  0.82,    1.0],
        ],

    },
    "vehicleController": {
        "revMatchThrottle":0.2,
        "clutchLaunchStartRPM":2200,
        "clutchLaunchTargetRPM":3100,
    },
    "mainEngine":{
        "turbocharger":"turbocharger",
        "instantAfterFireCoef": 0.1,
        "sustainedAfterFireCoef": 0.1,
		"sustainedAfterFireTime": 3,
    },
    "soundConfig": {
        "$+maxLoadMix": 0.1,
        "$+intakeMuffling":-0.2,
        "$+mainGain":1.5,
        "$+eqLowGain": 1.5,
    },
    "soundConfigExhaust": {
        "$+maxLoadMix": 0.1,
        "$+minLoadMix": 0.01,
        "$+mainGain": 0.5,
        "$+offLoadGain": 0.00,
        "$+eqLowGain": 0.25,
        "$+eqFundamentalGain": 0.5,
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["covet_icpipe_intake", ["covet_icpipe_intake","covet_intercooler","covet_radiator"]],
        ["covet_icpipe_R", ["covet_icpipe_turbo","covet_intercooler","covet_radiator"]],
        ["covet_header_turbo", ["covet_engine"]],
        ["covet_intake", ["covet_engine"]],
        ["covet_intercooler", ["covet_intercooler","covet_radiator"]],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["covet_intakepipe_turbo", ["covet_icpipe_intake","covet_intercooler","covet_radiator"]],
        ["covet_downpipe_turbo", ["covet_engine"]],
        ["covet_icpipe_L", ["covet_engine"]],
        ["covet_header_turbo", ["covet_engine"]],
        ["covet_intake", ["covet_engine"]],
        ["covet_icpipe_R", ["covet_engine"]],
        ["covet_intercooler", ["covet_intercooler","covet_radiator"]],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"selfCollision":false},
         {"collision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"covet_intercooler"},
         {"nodeWeight":6},
         ["interc", 0.0, -1.81, 0.45],
         {"nodeWeight":3},
         {"group":"covet_icpipe_intake"},
         ["airb1", -0.25, -1.20, 0.57],
         {"group":"covet_icpipe_turbo"},
         ["airb2", 0.21, -1.67, 0.43],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":301000,"beamDamp":60},
          {"beamDeform":3000,"beamStrength":"FLT_MAX"},
          {"deformGroup":"mainEngine_intercooler", "deformationTriggerRatio":0.1}
          ["interc","f15r"],
          ["interc","f15"],
          ["interc","f15l"],
          ["interc","f10rr"],
          ["interc","f10ll"],
          {"beamDeform":3000,"beamStrength":16000},
          ["interc","f11rr"],
          ["interc","f11"],
          ["interc","f11ll"],

          {"beamSpring":5010000,"beamDamp":90},
          {"beamDeform":90000,"beamStrength":"FLT_MAX"},
          {"deformGroup":"mainEngine_piping", "deformationTriggerRatio":0.01}
          ["airb1","e1r"],
          ["airb1","e1l"],
          ["airb1","e3r"],
          ["airb1","e3l"],
          ["airb1","e4r"],
          ["airb1","e4l"],
          {"deformGroup":"mainEngine_turbo", "deformationTriggerRatio":0.01}
          ["airb2","e2r"],
          ["airb2","e2l"],
          ["airb2","e4r"],
          ["airb2","e4l"],
          ["airb2","e3r"],
          ["airb2","e3l"],
          {"deformGroup":""},
          {"beamType":"|BOUNDED", "beamLongBound":0.025, "beamShortBound":0.025},
          {"beamSpring":0,"beamDamp":60},
          {"beamLimitSpring":1001000,"beamLimitDamp":100},
          {"beamDeform":3000,"beamStrength":3000},
          ["airb1","f15"],
          ["airb1","f15l"],
          ["airb1","f11"],
          ["airb1","f11ll"],

          ["airb2","f15"],
          ["airb2","f15r"],
          ["airb2","f11"],
          ["airb2","f11rr"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},
