{
"midtruck_ALS_intake_diesel": {
    "information":{
        "authors":"BeamNG",
        "name":"ALS Stage 3 Variable Boost Turbocharger",
        "value":3000,
    }
    "slotType" : "midtruck_intake_diesel",
    // ALS wiring - do not edit by hand
    "actionsEnabled": [
        ["id"],
        ["als_toggle"],
        ["als_scramble"],
        ["als_rolling"],
    ],
    "controller": [
        ["fileName"],
        ["powertrainControl/als_antiLag", {"name": "alsAntiLag"}],
    ],
    "alsAntiLag": {
        "turboTargetRPM": 90000,
        "minActiveEngineRPM": 1500,
        "minActiveWheelSpeed": 1,
        "maxActiveThrottleInput": 0.2,
        "minActiveBrakeInput": 0.2,
        "timeoutTime": 30,
        "timeoutResetTime": 2,
    },
    // end of ALS wiring
	"slots": [
		["type", "default", "description"],
        ["ALSboostController","NoBBG", "Boost Controller", {"coreSlot":true}],
		["TurboNormalization", "", "Turbo Normalization"],
    ],
	"variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"]
        ["$ALSDuration", "range", "s", "Engine", 2, 0.5, 10, "ALS duration", "ALS duration in seconds"{"stepDis":0.5}],
	],
    "turbocharger": {
        "maxAntilagPower": 13560,
        "bovSoundFileName":"event:>Vehicle>Forced_Induction>Turbo_05>turbo_bov"
        "hissLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_05>turbo_hiss"
        "whineLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_05>turbo_spin"
        "bovEnabled":true,
        "flutterSoundVolumeCoef":0.6,
		"hissVolumePerPSI": 0.02,
		"whineVolumePer10kRPM": 0.05,
        "whinePitchPer10kRPM": 0.01,
        "wastegateStart":10,
		"bovSoundVolumeCoef" : 1,
        "wastegateLimit":10,
        "maxExhaustPower": 180000,
		"bovSoundPressureCoef" : 1,  //ALS
		"ALSTime" : "$ALSDuration",
		
		"ALS" : true,
		"ALSExhaustPower" : 180000,
		"ALSPressure" : 12,
		"ALSInstantLoadDrop" : 0.7,
		
		
        "backPressureCoef": 0.0001,
        "frictionCoef": 155.3,
        "inertia":15.4,
        "pressureRatePSI": 75,
        "damageThresholdTemperature": 1200,
        "pressurePSI":[
            //turbineRPM, pressure(PSI)
            //turbineRPM, pressure(PSI)
            [0,         -4],
            [30000,     -2.5],
            [60000,     3],
            [90000,     15],
            [150000,    20],
            [200000,    70],
            [250000,    98],
            [300000,    150],
        ],
        "engineDef":[
            //engineRPM, efficiency, exhaustFactor
            [0,     0.0,    0.0],
            [650,   0.15,   0.1],
            [1400,  0.38,   0.4],
            [2000,  0.40,    0.45],
            [2500,  0.42,    0.49],
            [2750,  0.48,    0.50],
            [3000,  0.55,    0.58],
            [4000,  0.84,    0.75],
            [5000,  0.92,    0.8],
            [6000,  1.0,    0.85],
            [7000,  0.94,    0.95],
            [8000,  0.90,    1.0],
            [9000,  0.87,    1.0],
        ],
    },
    "vehicleController": {
        "revMatchThrottle":0.2,
        "clutchLaunchStartRPM":2200,
        "clutchLaunchTargetRPM":3100,
    },
    "mainEngine":{
        "turbocharger":"turbocharger",
        "instantAfterFireCoef": 0.1,
        "sustainedAfterFireCoef": 0.1,
		"sustainedAfterFireTime": 3,
    },
    "flexbodies": [
            ["mesh", "[group]:", "nonFlexMaterials"],
            ["midtruck_header_diesel", ["midtruck_engine", "midtruck_turbo"]],
            ["midtruck_turbo_td_large", ["midtruck_engine", "midtruck_turbo"]],
            ["midtruck_intake_diesel", ["midtruck_engine", "midtruck_intake"]],
            ["midtruck_intakecoupling_td_large", ["midtruck_engine", "midtruck_intake"]],
            ["midtruck_exhaust_td_large", ["midtruck_engine", "midtruck_header"]],
            ["midtruck_intercooler_td_large", ["midtruck_intercooler"]],
            {"deformGroup":"mainEngine_piping", "deformMaterialBase":"midtruck", "deformMaterialDamaged":"invis"},
            ["midtruck_chargepipe_td_large", ["midtruck_intercooler", "midtruck_turbo", "midtruck_intake"]],
            {"deformGroup":"intakehose_damage", "deformMaterialBase":"midtruck", "deformMaterialDamaged":"invis"},
            ["midtruck_intakepipe_td_large", ["midtruck_body", "midtruck_turbo"]],
            {"deformGroup":""},
        ],
        "nodes": [
            ["id", "posX", "posY", "posZ"],
            {"selfCollision":false},
            {"collision":true},
            {"frictionCoef":0.5},
            {"nodeMaterial":"|NM_METAL"},

            //turbo
            {"nodeWeight":4.5},
            {"group":"midtruck_turbo"},
            {"engineGroup":"engine_intake"},
            ["trb1",-0.236,-0.798,1.036],
            ["trb2",-0.233,-0.606,1.015],
            {"engineGroup":""},

            //intake manifold
            {"nodeWeight":2.5},
            {"group":"midtruck_intake"},
            ["im1",0.102,-0.801,0.998],
            ["im2",0.107,-0.478,0.964],

            //exhaust manifold
            {"group":"midtruck_header"},
            ["exm1",-0.202,-0.32,0.954],
            ["exm2",0.263,-0.374,0.579],
            ["exm3",0.286,-0.272,0.566],

            //intercooler
            {"nodeWeight":1.5},
            {"group":"midtruck_intercooler"},
            ["intc1r", -0.22,-1.8,1.12],
            ["intc1", 0.0,-1.8,1.154],
            ["intc1l", 0.22,-1.8,1.12],

            ["intc2r", -0.22,-1.8,0.887],
            ["intc2", 0.0,-1.8,0.887],
            ["intc2l", 0.22,-1.8,0.887],

            {"engineGroup":""},
            {"group":""},
            ["intc3",0.0,-1.72,1.0],
            {"engineGroup":""},
            {"group":""},
        ],
        "beams": [
            ["id1:", "id2:"],
            {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

            //turbo
            {"beamSpring":2750550,"beamDamp":125},
            {"beamDeform":30000,"beamStrength":"FLT_MAX"},
            {"deformLimitExpansion":""},
            {"deformGroup":"mainEngine_turbo", "deformationTriggerRatio":0.001}
            ["e1r", "trb1", {"isExhaust":"mainEngine"}],
            ["trb1", "trb2", {"isExhaust":"mainEngine"}],
            ["trb1", "e2r"],
            ["trb1", "e3r"],
            ["trb1", "e4r"],
            ["trb1", "e1l"],
            ["trb1", "e2l"],
            ["trb1", "e3l"],
            ["trb1", "e4l"],
            ["trb2", "e2r"],
            ["trb2", "e4r"],
            ["trb2", "e1r"],
            ["trb2", "e3r"],
            ["trb2", "e4l"],
            ["trb2", "e2l"],
            ["trb2", "e3l"],
            ["trb2", "e1l"],

            //intake manifold
            {"beamSpring":2150550,"beamDamp":85},
            {"beamDeform":30000,"beamStrength":"FLT_MAX"},
            ["im1", "im2"],
            ["im2", "e2l"],
            ["im2", "e2r"],
            ["im2", "e1r"],
            ["im2", "e1l"],
            ["im1", "e1l"],
            ["im1", "e1r"],
            ["im1", "e2r"],
            ["im1", "e2l"],
            ["im1", "e3l"],
            ["im2", "e4l"],
            ["im1", "e4l"],
            ["im2", "e3l"],

            //exhaust manifold
            {"beamSpring":2750550,"beamDamp":125},
            {"beamDeform":30000,"beamStrength":"FLT_MAX"},
            ["trb2", "exm1", {"isExhaust":"mainEngine"}],
            ["exm1", "exm2", {"isExhaust":"mainEngine"}],
            ["exm3", "exm2", {"isExhaust":"mainEngine"}],
            ["exm1", "e2r"],
            ["exm1", "e4r"],
            ["exm1", "e4l"],
            ["exm1", "e2l"],
            ["exm2", "e2l"],
            ["exm2", "e4l"],
            ["exm2", "e3l"],
            ["exm2", "e1l"],
            ["exm3", "exm1"],
            ["exm3", "e4l"],
            ["exm3", "e3l"],
            ["exm3", "e1l"],
            ["exm3", "e4r"],
            ["exm3", "e2r"],

            //intercooler
            {"beamSpring":1001000,"beamDamp":100},
            {"beamDeform":15000,"beamStrength":"FLT_MAX"},
            {"deformGroup":"mainEngine_intercooler", "deformationTriggerRatio":0.1}
            {"deformLimitExpansion":1.5},
            ["intc2r", "intc2"],
            ["intc2", "intc2l"],
            ["intc2l", "intc1l"],
            ["intc1l", "intc1"],
            ["intc1", "intc1r"],
            ["intc1r", "intc2r"],
            ["intc2", "intc1"],
            //cross
            {"beamDeform":5500,"beamStrength":"FLT_MAX"},
            {"deformLimitExpansion":""},
            ["intc1", "intc2l"],
            ["intc2", "intc1l"],
            ["intc1", "intc2r"],
            ["intc1r", "intc2"],
            //rigids
            ["intc2r", "intc2l"],
            ["intc1r", "intc1l"],
            //rigidifier
            ["intc3", "intc2"],
            ["intc3", "intc1"],
            ["intc3", "intc2r"],
            ["intc3", "intc2l"],
            ["intc3", "intc1r"],
            ["intc3", "intc1l"],
            {"deformGroup":""},

            //attach
            {"beamDeform":4500,"beamStrength":"FLT_MAX"},
            ["intc1r", "f17r"],
            ["intc1r", "s3r"],
            ["intc1r", "f9r"],
            ["intc2r", "f2r"],
            ["intc2r", "f1r"],
            ["intc2r", "f1"],
            ["intc2r", "f9r"],
            ["intc2r", "f17r"],
            ["intc1r", "f1r"],
            ["intc1r", "f2r"],

            ["intc1l", "f17l"],
            ["intc1l", "s3l"],
            ["intc1l", "f9l"],
            ["intc2l", "f2l"],
            ["intc2l", "f1l"],
            ["intc2l", "f1"],
            ["intc2l", "f9l"],
            ["intc2l", "f17l"],
            ["intc1l", "f1l"],
            ["intc1l", "f2l"],
            {"deformLimitExpansion":""},

            //intercooler piping
            {"beamSpring":501000,"beamDamp":400},
            {"beamDeform":5000,"beamStrength":15000},
            {"deformGroup":"mainEngine_piping", "deformationTriggerRatio":0.01}
            ["intc1r", "trb1"],
            ["intc2r", "trb1"],
            ["intc2", "trb1"],
            ["intc1", "trb1"],
            ["intc2l", "im1"],
            ["intc1l", "im1"],
            ["intc2", "im1"],
            ["intc1", "im1"],

            //intake hoses
            {"beamSpring":15000,"beamDamp":300},
            {"beamDeform":1450,"beamStrength":6600},
            {"deformGroup":"intakehose_damage","deformationTriggerRatio":0.02},
            ["trb1", "f16r"],
            ["trb1", "f16l"],
            ["trb2", "f16l"],
            ["trb2", "f16r"],
            ["trb1", "f17r"],
            ["trb1", "f9ll"],
            {"deformGroup":""}

            {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        ],
},
