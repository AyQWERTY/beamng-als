{
"utv_i3_intake_ALS_turbo": {
    "information":{
        "authors":"BeamNG",
        "name":"ALS Stage 3 Variable Boost Twin Turbocharger System",
        "value":14600,
    },
    "slotType" : "utv_i3_intake",
    // ALS wiring - do not edit by hand
    "actionsEnabled": [
        ["id"],
        ["als_toggle"],
        ["als_scramble"],
        ["als_rolling"],
    ],
    "controller": [
        ["fileName"],
        ["powertrainControl/als_antiLag", {"name": "alsAntiLag"}],
    ],
    "alsAntiLag": {
        "turboTargetRPM": 90000,
        "minActiveEngineRPM": 1500,
        "minActiveWheelSpeed": 1,
        "maxActiveThrottleInput": 0.2,
        "minActiveBrakeInput": 0.2,
        "timeoutTime": 30,
        "timeoutResetTime": 2,
    },
    // end of ALS wiring
    "slots": [
		["type", "default", "description"],
        ["ALSboostController","NoBBG", "Boost Controller", {"coreSlot":true}],
		["TurboNormalization", "", "Turbo Normalization"],
        ["utv_i3_exhaust_turbo","utv_i3_exhaust_turbo", "Exhaust"],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$ALSDuration", "range", "s", "Engine", 2, 0.5, 10, "ALS duration", "ALS duration in seconds"{"stepDis":0.5}],
    ],
    "turbocharger": {
        "maxAntilagPower": 5340,
        "bovSoundFileName":"event:>Vehicle>Forced_Induction>Turbo_03>turbo_bov_race",
        "hissLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_03>turbo_hiss_race",
        "whineLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_03>turbo_spin_race",
        "bovEnabled":true,
        "turboSizeCoef": 1.0,
        "bovSoundVolumeCoef": 0.65,
        "hissVolumePerPSI": 0.032,
        "whineVolumePer10kRPM": 0.012,
        "whinePitchPer10kRPM": 0.055,
        "wastegateStart":10,
        "pressureRatePSI": 50
        "maxExhaustPower": 180000,
        "backPressureCoef": 0.00004,
        "frictionCoef": 10,
        "inertia":2.1,
        "damageThresholdTemperature": 1200,

		"ALSTime" : "$ALSDuration",
		"ALS" : true,
		"ALSExhaustPower" : 180000,
		"ALSPressure" : "$ALSPressurePsi",
		"ALSInstantLoadDrop" : 0.7,

        "pressurePSI":[
            //turbineRPM, pressure(PSI)
            [0,         -4],
            [30000,     -2.5],
            [60000,     3],
            [90000,     15],
            [150000,    20],
            [200000,    70],
            [250000,    98],
            [300000,    150],
        ],
        "engineDef":[
            //engineRPM, efficiency, exhaustFactor
            [0,     0.0,      0.0],
            [650,   0.03,    0.05],
            [1400,  0.05,    0.10],
            [2000,  0.18,    0.20],
            [3000,  0.55,    0.35],
            [4000,  0.60,    0.55],
            [5000,  0.67,    0.60],
            [6000,  0.89,    0.85],
            [7000,  0.98,    0.99],
            [8000,  0.99,    0.94],
            [9000,  0.90,    0.80],
            [10000, 0.85,    0.78],
            [11000, 0.78,    0.75],
        ],
    },
    "mainEngine":{
        //turbocharger name
        "turbocharger":"turbocharger",
        "$*instantAfterFireCoef": 5.0,
        "$*sustainedAfterFireCoef": 2.5,
        "$*sustainedAfterFireVolumeCoef": 1.1,

        //damage deformGroups
        "deformGroups_turbo":["mainEngine_turbo_R","mainEngine_turbo_L","mainEngine_intercooler_R","mainEngine_intercooler_L"]
    },
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["utv_intakebox", ["utv_engine"]],
         ["utv_exhaust_manifold", ["utv_engine", "utv_turbo"]],
         ["utv_turbocharger", ["utv_engine", "utv_turbo"]],
         ["utv_radiator_R", ["utv_intercooler"]],
         ["utv_fanbody_R", ["utv_intercooler"]],
         {"deformGroup":"mainEngine_intercooler", "deformMaterialBase":"utv_main", "deformMaterialDamaged":"invis"},
         ["utv_pipe_turbo_intake", ["utv_engine","utv_intercooler"]],
         ["utv_pipe_radtoturbo", ["utv_engine","utv_intercooler"]],
         {"deformGroup":""},
         ["utv_intake_pipe_turbo", ["utv_intake_pipe","utv_turbo", "utv_engine"]],
    ],
    "props": [
        ["func", "mesh", "idRef:", "idX:", "idY:", "baseRotation", "rotation", "translation", "min", "max", "offset", "multiplier"],
        ["radiatorFanSpin", "utv_intercooler_fan", "intc1r", "intc1l", "intc2r", {"x":90, "y":0, "z":0}, {"x":0, "y":0, "z":0.5}, {"x":0, "y":0, "z":0}, -360, 360, 0, 1 {"deformGroup":["radiator_damage"]}],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"selfCollision":false},
         {"collision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},

         //turbo
         {"group":"utv_turbo"},
         {"nodeWeight":1.5},
         ["trb1r",-0.023,0.67,1.015],
         ["trb1l",0.123,0.67,1.015],
         {"collision":true},

         //intercooler
         {"nodeWeight":0.5},
         {"group":"utv_intercooler"},
         ["intc1r",-0.165,0.628,1.192],
         ["intc1l",0.165,0.628,1.192],
         ["intc2r",-0.165,0.862,1.192],
         ["intc2l",0.165,0.862,1.192],
         ["intc3",0.0,0.755,1.095],

         //intake pipe
         {"group":"utv_intake_pipe"},
         ["intk1",0.6,0.68,1.3, {"engineGroup":"engine_intake"}],
         {"group":""},

    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          //turbo
          {"beamSpring":2750550,"beamDamp":125},
          {"beamDeform":60000,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":""},
          {"deformGroup":"mainEngine_turbo", "deformationTriggerRatio":0.001}
          ["e4r", "trb1l", {"isExhaust":"mainEngine"}],
          ["trb1l", "trb1r", {"isExhaust":"mainEngine"}],
          ["trb1l", "e2r"],
          ["trb1l", "e3r"],
          ["trb1l", "e1r"],
