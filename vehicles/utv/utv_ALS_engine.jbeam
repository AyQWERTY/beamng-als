          //charge pipes
          {"beamSpring":501000,"beamDamp":60},
          {"beamDeform":8000,"beamStrength":12000},
          {"deformGroup":"mainEngine_piping", "deformationTriggerRatio":0.001}
          ["trb1l", "intc2l"],
