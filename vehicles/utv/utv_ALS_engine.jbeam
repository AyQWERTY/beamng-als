          ["trb1l", "e3l"],
          ["trb1r", "e3l"],
          ["trb1r", "e4l"],

          //intercooler
          {"beamSpring":501000,"beamDamp":20},
          {"beamDeform":12000,"beamStrength":"FLT_MAX"},
          {"deformGroup":"mainEngine_intercooler", "deformationTriggerRatio":0.02}
          ["intc2r", "intc1r"],
          ["intc1r", "intc1l"],
          ["intc1l", "intc2l"],
          ["intc2l", "intc2r"],
