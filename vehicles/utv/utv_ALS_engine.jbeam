          //airbox pipe
          {"beamSpring":30550,"beamDamp":125},
          {"beamDeform":3000,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":1.2},
          //{"deformGroup":"airbox","deformationTriggerRatio":0.01},
          ["intk1", "e4l"],
          ["intk1", "e4r"],
          ["intk1", "e3l"],
          ["intk1", "e3r"],
