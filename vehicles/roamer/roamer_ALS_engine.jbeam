         //--turbo and intercooler weight--
         {"selfCollision":false},
         {"collision":false}
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":""},
         {"nodeWeight":16},
         ["turbo", 0, -1.73, 0.51],
         {"collision":true}
         {"group":"pessima_intercooler"},
         {"nodeWeight":9},
         ["interc", 0.0, -2.00, 0.35],
         {"nodeWeight":1},
         {"group":"pessima_intercooler"},
         ["airb1", 0.15, -1.22, 0.73],
         ["airb2", 0.1, -1.73, 0.41],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":2750550,"beamDamp":125},
          {"beamDeform":30000,"beamStrength":"FLT_MAX"},
          ["turbo", "e1r"],
          ["turbo", "e2r"],
          ["turbo", "e3r"],
          ["turbo", "e4r"],
          ["turbo", "e3l"],
          ["turbo", "e2l"],

          {"beamSpring":501000,"beamDamp":60},
          {"beamDeform":4000,"beamStrength":12000},
          {"breakGroup":"radtube"},
          ["airb1","e1r"],
          ["airb1","e1l"],
          ["airb1","e3r"],
          ["airb1","e3l"],
          ["airb1","e4r"],
          ["airb1","e4l"],
          
          ["airb2","e2r"],
          ["airb2","e2l"],
          ["airb2","e4r"],
          ["airb2","e4l"],
          ["airb2","e3r"],
          ["airb2","e3l"],
          {"breakGroup":""},

          {"beamSpring":501000,"beamDamp":100},
          {"beamDeform":3000,"beamStrength":"FLT_MAX"},
          ["interc","f13rr"],
          ["interc","f13"],
          ["interc","f13ll"],
          ["interc","f11rr"],
          ["interc","f11"],
          ["interc","f11ll"],

          {"beamDeform":3000,"beamStrength":16000},
          ["interc","f18"],
          ["interc","f18r"],
          ["interc","f18l"],

          {"beamType":"|BOUNDED", "beamLongBound":0.025, "beamShortBound":0.025},
          {"beamSpring":20000,"beamDamp":50},
          {"beamLimitSpring":1001000,"beamLimitDamp":200},
          {"beamDeform":4000,"beamStrength":"FLT_MAX"},
          ["airb1", "f11ll"],
          ["airb1", "f15l"],
          ["airb1", "f15"],
          ["airb1", "f11"],

          ["airb2", "f11ll"],
