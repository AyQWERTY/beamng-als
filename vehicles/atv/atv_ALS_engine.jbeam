        "whinePitchPer10kRPM": 0.01,
        "wastegateStart":10,
		"bovSoundVolumeCoef" : 1,
        "wastegateLimit":10,
        "maxExhaustPower": 180000,
		"bovSoundPressureCoef" : 1,  //ALS
		"ALSTime" : "$ALSDuration",
		
		"ALS" : true,
		"ALSExhaustPower" : 180000,
		"ALSPressure" : "$ALSPressurePsi",
		"ALSInstantLoadDrop" : 0.7,
		
		
        "backPressureCoef": 0.0001,
        "frictionCoef": 155.3,
        "inertia":15.4,
        "pressureRatePSI": 75,
        "damageThresholdTemperature": 1200,
        "pressurePSI":[
            //turbineRPM, pressure(PSI)
            [0,         -4],
            [30000,     -2.5],
            [60000,     3],
            [90000,     15],
            [150000,    20],
            [200000,    70],
            [250000,    98],
            [300000,    150],
        ],
        "engineDef":[
            //engineRPM, efficiency, exhaustFactor
            [0,     0.0,    0.0],
            [650,   0.15,   0.1],
            [1400,  0.38,   0.4],
            [2000,  0.40,    0.45],
            [2500,  0.42,    0.49],
            [2750,  0.48,    0.50],
            [3000,  0.55,    0.58],
            [4000,  0.84,    0.75],
            [5000,  0.92,    0.8],
            [6000,  1.0,    0.85],
            [7000,  0.94,    0.95],
            [8000,  0.90,    1.0],
            [9000,  0.87,    1.0],
        ],

    },
    "vehicleController": {
        "revMatchThrottle":0.2,
        "clutchLaunchStartRPM":2200,
        "clutchLaunchTargetRPM":3100,
    },
    "mainEngine":{
        "turbocharger":"turbocharger",
        "instantAfterFireCoef": 0.1,
        "sustainedAfterFireCoef": 0.1,
		"sustainedAfterFireTime": 3,
        "deformGroups_turbo":["mainEngine_turbo","mainEngine_intercooler"]
    },
    "soundConfig": {
        "$+mainGain": 0.25,
        "$+intakeMuffling":-0.4,
        "$+maxLoadMix": 0.15,
        "$+minLoadMix": 0.21,
