{
  "fileversion": 2,
  "actions": {
    "als_toggle": {
      "order": 20,
      "onDown": "electrics.values.alsEnabled = 1 - (electrics.values.alsEnabled or 0)",
      "onUp": "guihooks.message('ALS ' .. ((electrics.values.alsEnabled or 0) == 1 and 'enabled' or 'disabled'), 4, 'ALS')",
      "title": "ALS: Toggle",
      "desc": "Toggles the anti-lag system"
    },
    "als_scramble": {
      "order": 21,
      "onDown": "electrics.values.alsScramble = 1 - (electrics.values.alsScramble or 0)",
      "onUp": "guihooks.message('Scramble ' .. ((electrics.values.alsScramble or 0) == 1 and 'enabled' or 'disabled'), 4, 'ALS')",
      "title": "ALS: Scramble boost",
      "desc": "Raises the boost limit for a temporary overboost"
    },
    "als_rolling": {
      "order": 22,
      "onDown": "electrics.values.alsRolling = 1",
      "onUp": "electrics.values.alsRolling = 0",
      "title": "ALS: Rolling anti-lag",
      "desc": "Hold to keep anti-lag active while rolling"
    },
    "als_launch": {
      "order": 23,
      "onDown": "electrics.values.alsLaunch = 1",
      "onUp": "electrics.values.alsLaunch = 0",
      "title": "ALS: Rolling launch",
      "desc": "Hold to pin the engine at the RPM it was at when the key was pressed, while anti-lag stays engaged"
    }
  }
}
